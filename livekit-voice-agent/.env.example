# ══════════════════════════════════════════════════════════════════════════════
# EVERY KEY IN THIS FILE IS OPTIONAL.
# Have a key? Paste it and that piece automatically uses the commercial service.
# No key? That piece automatically runs on YOUR computer, free forever.
# ══════════════════════════════════════════════════════════════════════════════

# ── LiveKit (connects your mic to the agent) ──────────────────────────────────
# Option A (default set by setup): the LOCAL server, no account needed.
# Option B: LiveKit Cloud (free tier) - https://cloud.livekit.io → Settings →
#           Keys. Needed when other people should reach your agent over the
#           internet; replace the three values below (also in the frontend's
#           agent-starter-react/.env.local).
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=APIxxxxxxxxxxxxxxxxx
LIVEKIT_API_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── STT: speech to text ───────────────────────────────────────────────────────
# auto (default): ASSEMBLYAI_API_KEY set -> AssemblyAI; empty -> local Whisper
# Or force one of: assemblyai | whisper-local | openai-compatible
#STT_PROVIDER=auto
# whisper-local model size: base (fastest) | small (default) | medium (best)
#STT_MODEL=small
# openai-compatible only (e.g. a Speaches server):
#STT_BASE_URL=http://localhost:8000/v1
#STT_API_KEY=
# assemblyai: https://www.assemblyai.com/app → API Keys
ASSEMBLYAI_API_KEY=

# ── TTS: text to speech ───────────────────────────────────────────────────────
# auto (default): CARTESIA_API_KEY set -> Cartesia; empty -> local Piper
# Or force one of: cartesia | piper-local | openai-compatible
#TTS_PROVIDER=auto
# piper-local voices: https://rhasspy.github.io/piper-samples/ (default: en_US-lessac-medium)
# cartesia: a voice ID from their library
#TTS_VOICE=
# openai-compatible only (e.g. a local Kokoro server):
#TTS_BASE_URL=http://localhost:8880/v1
#TTS_API_KEY=
# cartesia: https://play.cartesia.ai → API Keys
CARTESIA_API_KEY=

# ── LLM: the brain ────────────────────────────────────────────────────────────
# auto (default): uses whichever key you set below (anthropic > openai >
# google > groq); with no keys the brain runs locally via Ollama for free.
# Or force one of: ollama | openai-compatible | anthropic | openai | google | groq
LLM_PROVIDER=auto

# Optional: override the model for the chosen provider. Defaults per provider:
#   ollama             llama3.1:8b
#   openai-compatible  meta-llama/Llama-3.1-8B-Instruct
#   anthropic          claude-opus-5
#   openai             gpt-5.1
#   google             gemini-2.5-flash
#   groq               llama-3.3-70b-versatile
#LLM_MODEL=

# ── Self-hosted options ───────────────────────────────────────────────────────
# ollama: where your Ollama server listens (default shown)
#OLLAMA_BASE_URL=http://localhost:11434/v1

# openai-compatible: any server speaking the OpenAI API (vLLM, llama.cpp,
# LM Studio, TGI...). LLM_BASE_URL is required, LLM_API_KEY only if your
# server enforces one.
#LLM_BASE_URL=http://localhost:8000/v1
#LLM_API_KEY=

# ── Hosted provider API keys (only for the provider you picked) ──────────────
# https://console.anthropic.com → API Keys
#ANTHROPIC_API_KEY=
# https://platform.openai.com → API Keys
#OPENAI_API_KEY=
# https://aistudio.google.com → Get API key
#GOOGLE_API_KEY=
# https://console.groq.com → API Keys (free tier available)
#GROQ_API_KEY=
